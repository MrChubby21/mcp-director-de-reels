{
  "name": "mcp-director-de-reels",
  "version": "1.0.0",
  "description": "MCP que conecta la IA con mi app Director de Reels (hecho desde el mcp-starter-kit del curso CTR20233)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-director-de-reels": "dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "crear-mcp": "node constructor/servidor.mjs",
    "new-tool": "node scripts/new-tool.mjs",
    "configurar": "node scripts/configurar-opencode.mjs",
    "configurar:global": "node scripts/configurar-opencode.mjs --global",
    "test": "npm run build && node scripts/smoke-test.mjs",
    "configurar-ia": "node scripts/configurar-ia.mjs",
    "instalar-ia": "node scripts/instalar-opencode.mjs && node scripts/configurar-ia.mjs",
    "setup": "node instalador/setup.mjs",
    "construir-instaladores": "node instalador/construir.mjs",
    "diagnostico": "node scripts/diagnostico.mjs",
    "probar-director": "node scripts/probar-director.mjs",
    "probar-ejemplo": "node scripts/probar-ejemplo.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opencode",
    "director-de-reels"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
